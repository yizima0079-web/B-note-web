# ── 应用安全 ──────────────────────────────────────────────
# 用于签发 Web 会话 JWT 与派生 B 站凭证加密密钥，务必改成随机长字符串
SECRET_KEY=please-change-this-to-a-long-random-string
# 网页访问口令（自托管单用户模式的登录门槛）
APP_PASSWORD=change-me
# 生产环境启用 HTTPS 时设为 true（Cookie 仅在 HTTPS 下发送）
COOKIE_SECURE=false
# 会话有效期（小时）
SESSION_TTL_HOURS=72

# ── 数据存储 ──────────────────────────────────────────────
DATA_DIR=./data

# ── 大模型（OpenAI 兼容接口：OpenAI / DeepSeek / 通义 / Kimi / Ollama 等）─
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=180

# ── 语音转写（无字幕视频的兜底层，即三层降级的第 3 层）──
# provider=tencent：腾讯云「录音文件识别极速版」（HTTPS 同步，30 分钟音频约 10 秒返回，推荐）
# provider=openai ：OpenAI/Groq 兼容 /audio/transcriptions
ASR_PROVIDER=tencent
ASR_TIMEOUT=300

# 【腾讯云 ASR】在「语音识别控制台 → API 密钥管理」获取；三项缺一即跳过 ASR 层
# 控制台：https://console.cloud.tencent.com/cam/capi
TENCENT_APPID=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# 引擎：16k_zh 中文通用；16k_zh_en 中英粤；16k_en 英文；16k_ja 日语 等
TENCENT_ENGINE_TYPE=16k_zh
# 音频格式：B 站 dash 音频流通常为 m4a
TENCENT_VOICE_FORMAT=m4a

# 【OpenAI/Groq 兼容 ASR】仅当 ASR_PROVIDER=openai 时生效
ASR_BASE_URL=https://api.groq.com/openai/v1
ASR_API_KEY=
ASR_MODEL=whisper-large-v3

# ── 长文本分块（map-reduce，发挥模型长文解析能力）──
CHUNK_SIZE=4000
CHUNK_OVERLAP=200
MAP_CONCURRENCY=3

# ── 任务 ──────────────────────────────────────────────────
MAX_CONCURRENT_TASKS=2

# ── 跨域（前端与后端分离部署时填写，同源部署可留空）──────────
CORS_ORIGINS=
